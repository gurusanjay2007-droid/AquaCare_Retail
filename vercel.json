{
  "functions": {
    "api/index.py": {
      "includeFiles": "frontend/**,backend/**,public/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.py?__path__=/api/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/api/index.py?__path__=/:path*"
    }
  ]
}


