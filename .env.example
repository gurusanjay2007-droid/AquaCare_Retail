# PureFlow Service Hub – Environment Configuration
# Copy this file to .env and fill in your values

# Flask secret key (change this to a random string)
SECRET_KEY=pureflow-secret-key-change-me-2024

# Database Configuration
# For SQLite (default, no setup needed):
DATABASE_URL=sqlite:///pureflow.db

# For MySQL, comment out the SQLite line above and use:
# DATABASE_URL=mysql+pymysql://username:password@localhost:3306/aquaserve_pro

# App Settings
FLASK_ENV=development
FLASK_DEBUG=True
